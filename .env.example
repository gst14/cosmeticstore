# Copiá este archivo como .env y completá los valores.
# Las variables VITE_* se incluyen en el bundle público: no pongas secretos.

# Google Sheets → Archivo → Compartir → Publicar en la web → elegir la hoja → CSV
# Si queda vacío, se usan los productos de ejemplo (src/data/sample.csv)
VITE_SHEET_CSV_URL=

# Código de país + área + número, sin + ni espacios (ej: 5493810000000)
VITE_WHATSAPP=

VITE_STORE_NAME=Rubor
